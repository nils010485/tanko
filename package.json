{
  "name": "tanko",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/shared",
    "packages/core",
    "packages/server",
    "packages/dashboard"
  ],
  "scripts": {
    "build": "npm run build -w @tanko/shared -w @tanko/core -w @tanko/server -w @tanko/dashboard",
    "dev": "npm run dev -w @tanko/server",
    "start": "node packages/server/dist/index.js",
    "test": "npm run test -w @tanko/server --if-present",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9"
  },
  "overrides": {
    "@puppeteer/browsers": "^3.2.1"
  }
}