services:
  tanko:
    build: .
    image: tanko:latest
    container_name: tanko
    restart: unless-stopped
    ports:
      # HOST:CONTAINER — dashboard + API + WebSocket
      - "8080:8080"
    environment:
      # Chapters as CBZ archives ('cbz') or folders of images ('img')
      CHAPTER_FORMAT: cbz
      # Number of chapters downloaded in parallel
      # DOWNLOAD_CONCURRENCY: "2"
      # Minimum delay (ms) between two requests to the same domain
      DOWNLOAD_THROTTLE_MS: "250"
      # Preferred languages (ISO codes, comma separated): filters sources at
      # import and chapters of multi-language sources. Empty = no filter.
      # Can also be changed at runtime in Settings.
      PREFERRED_LANGUAGES: "en"
      # Automatic import at startup: path (inside the container) of an
      # existing library to scan/match/sync.
      # IMPORT_PATH: /biblio
      # Auto-confirmation level: 'auto' (default, confident matches only),
      # 'all' (includes uncertain ones), 'none' (manual validation)
      # IMPORT_AUTO_CONFIRM: auto
      # "1" = imported series auto-download their future chapters
      # IMPORT_AUTO_DOWNLOAD: "0"
      # Source updates: restarts the container after a sync to load new
      # connectors. Set "0" to disable.
      # CONNECTORS_AUTO_RESTART: "0"
      # Uncomment to change the port inside the container
      # PORT: "8080"
    volumes:
      # SQLite database, settings and downloaded library
      - ./data:/data
      # Existing library to import (read-only recommended).
      # The right-hand path (/biblio) is the one to enter in the Import tab.
      # - /path/to/your/library:/biblio:ro
