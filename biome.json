{
    "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
    "files": {
        "includes": [
            "**",
            "!**/dist",
            "!**/node_modules",
            "!packages/core/vendor",
            "!**/package.json",
            "!**/package-lock.json",
            "!**/tsconfig*.json",
            "!packages/dashboard/src/index.css",
            "!.plasma"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 160
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "jsxQuoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "none",
            "arrowParentheses": "asNeeded"
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "overrides": [
        {
            "includes": ["packages/dashboard/src/components/icons.tsx"],
            "linter": {
                "rules": {
                    "a11y": {
                        "noSvgWithoutTitle": "off"
                    }
                }
            }
        },
        {
            "includes": ["packages/*/test/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noNonNullAssertion": "off"
                    },
                    "suspicious": {
                        "noExplicitAny": "off"
                    }
                }
            }
        }
    ]
}
